{
  "name": "dsh-sidebar-manager",
  "version": "0.11.1",
  "license": "MIT",
  "type": "module",
  "description": "DSH sidebar manager: collapses the left panel list into one group row, and its gear opens an edit mode to show, hide and drag-reorder sidebar extension entries and conversation view tabs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zuojinxin/dsh-sidebar-manager.git"
  },
  "homepage": "https://github.com/zuojinxin/dsh-sidebar-manager#readme",
  "bugs": {
    "url": "https://github.com/zuojinxin/dsh-sidebar-manager/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "sidebar"
  ],
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "scripts": {
    "test": "node --test test/*.test.js"
  }
}
